# mira backend runtime environment configuration
# port and host bindings
PORT=8000
HOST=0.0.0.0

# shared data directory path
SHARED_PATH=/shared/mock_world.json

# offline mode toggle
NEXT_PUBLIC_USE_CACHE=false

# spacetimedb host address
NEXT_PUBLIC_SPACETIMEDB_HOST=localhost:3001

# nvidia cloud nim credentials
NVIDIA_API_KEY=nvapi-replace-with-your-nvidia-nim-key
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1

# google gemini tri-account rotation credentials
GEMINI_API_KEY_PRIMARY=replace-with-primary-gemini-key
GEMINI_API_KEY_SECONDARY=replace-with-secondary-gemini-key
GEMINI_API_KEY_TERTIARY=replace-with-tertiary-gemini-key
